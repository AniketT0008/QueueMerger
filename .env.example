# Copy this file to .env and fill in your own key(s).
# Get a free Gemini API key at https://aistudio.google.com/apikey
#
# QueueMerge works with ZERO configuration -- if neither variable below is
# set (or .env doesn't exist), the pipeline automatically falls back to the
# offline HeuristicExtractor, no network or key required. Setting one of
# these just upgrades misconception extraction to real Gemini language
# understanding.

# Single key (most setups):
GEMINI_API_KEY=

# Multiple keys (optional, comma-separated, no spaces around commas).
# Use this instead of/alongside GEMINI_API_KEY to spread requests across
# more than one free-tier key -- each call round-robins to the next key,
# and a rate-limited/invalid key automatically retries on the next one
# before falling back to the heuristic extractor. If both variables are
# set, keys from GEMINI_API_KEYS are tried first.
# GEMINI_API_KEYS=key_one_here,key_two_here,key_three_here

# ---------------------------------------------------------------------------
# Optional Ignition Hacks V.7 sponsor hooks (all graceful if unset)
# ---------------------------------------------------------------------------

# ElevenLabs Creator Tier — "Brief me" spoken triage in Streamlit
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Discord / Slack / Activepieces HTTP trigger — POST on new outbreak alerts
# OUTBREAK_WEBHOOK_URL=https://discord.com/api/webhooks/...

# World Labs Marble — local demo (simplest):
# 1) Open starter kit: https://worldlabs.notion.site/Starter-Kit-30d8950a1bef806e90a5e030c6382297
# 2) Create/sign in at https://platform.worldlabs.ai and generate an API key
# 3) Paste it here (never commit .env):
# WORLD_LABS_API_KEY=
# Optional model override (draft is cheaper/faster for demos):
# WORLD_LABS_MODEL=marble-1.0-draft
#
# Production / public Pages: deploy worldlabs-proxy/ instead and set:
# WORLD_LABS_PROXY_URL=https://queuemerge-worldlabs-proxy.YOUR_SUBDOMAIN.workers.dev
